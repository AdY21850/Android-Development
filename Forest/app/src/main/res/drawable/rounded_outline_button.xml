<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Transparent background -->
    <solid android:color="@android:color/transparent" />

    <!-- Green outline -->
    <stroke
        android:width="@dimen/_2sdp"
        android:color="@color/Deep_Forest_Green" />

    <!-- Rounded corners -->
    <corners android:radius="@dimen/_30sdp" />

    <!-- Padding to make the button look clean -->
    <padding
        android:left="@dimen/_12sdp"
        android:right="@dimen/_12sdp"
        android:top="@dimen/_6sdp"
        android:bottom="@dimen/_6sdp"/>
</shape>
